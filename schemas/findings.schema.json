{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Muralha findings",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^F-[0-9]{3,}$" },
          "title": { "type": "string" },
          "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
          "status": { "enum": ["open", "planned", "fixed", "verified", "rejected"] },
          "location": { "type": "string" },
          "category": {
            "type": "string",
            "pattern": "^(A(0[1-9]|10)|LLM(0[1-9]|10)):2025$",
            "description": "Categoria OWASP: A01:2025 a A10:2025 (Top 10) ou LLM01:2025 a LLM10:2025 (Top 10 for LLM Applications)."
          },
          "description": { "type": "string" },
          "fix": { "type": "string" },
          "verdict": { "type": "string" }
        }
      }
    }
  }
}
